# Local Anvil RPC endpoint
RPC_URL=http://localhost:8545

# Well-known Anvil default test account (index 0) — funded automatically on
# every fresh anvil instance. Safe to keep as-is for local dev; never put a
# real/mainnet private key in this file.
DEPLOYER_KEY=

# Optional: fork Base mainnet instead of starting a plain local anvil. Only
# used when deploy.sh has to start anvil itself (i.e. nothing is already
# listening on RPC_URL). Leave unset for a plain local chain. On a fork,
# DeployWETH.s.sol and SeedTokens.s.sol both skip deployment automatically
# since the forked chainid is Base's real 8453, not 31337, and real tokens
# already exist there.
BASE_RPC_URL=

# Block to pin the Base fork to (only used when BASE_RPC_URL is set).
FORK_BLOCK_NUMBER=43000000
