# RPC endpoint deploy.sh targets. Local Anvil by default. deploy.sh only
# starts anvil itself when NOTHING is already reachable at this URL - so
# pointing this at a real chain's RPC (see "Base Sepolia" below) makes
# deploy.sh skip anvil entirely and broadcast for real, no other change
# needed.
RPC_URL=http://localhost:8545

# Well-known Anvil default test account (index 0) — funded automatically on
# every fresh anvil instance. Safe to keep as-is for local dev; never put a
# real/mainnet private key in this file.
DEPLOYER_KEY=

# Optional: fork Base mainnet instead of starting a plain local anvil. Only
# used when deploy.sh has to start anvil itself (i.e. nothing is already
# listening on RPC_URL). Leave unset for a plain local chain. On a fork,
# DeployWETH.s.sol and SeedTokens.s.sol both skip deployment automatically
# since the forked chainid is Base's real 8453, not 31337, and real tokens
# already exist there.
BASE_RPC_URL=

# Block to pin the Base fork to (only used when BASE_RPC_URL is set).
FORK_BLOCK_NUMBER=43000000

# ─── Base Sepolia (real testnet, not a local fork) ───
# There's no local anvil step for this - a testnet has no deep state worth
# forking, so you broadcast to it directly instead. To deploy here:
#   1. Set RPC_URL=https://sepolia.base.org (or your own Base Sepolia RPC)
#   2. Set DEPLOYER_KEY to a real testnet-only key, funded from a faucet
#      (e.g. https://www.alchemy.com/faucets/base-sepolia) - never reuse a
#      mainnet key here
#   3. Run ./deploy.sh as normal - DeployWETH.s.sol/SeedTokens.s.sol still
#      skip automatically (chainid 84532 != 31337; WETH already exists at
#      Base Sepolia's real predeploy address 0x4200...0006)
# Addresses land in data/84532/ and sync into apps/web like any other chain.

# HealthOracle roles. All three default to the anvil account above when
# unset, which is fine for local dev. In production these MUST be distinct
# addresses: the scorer key is the least-protected key in the system (see
# src/oracle/HealthOracle.sol), and collapsing it into the admin/guardian
# key defeats the role separation the contract is designed around.
ORACLE_ADMIN=
ORACLE_SCORER=
ORACLE_GUARDIAN=

# Seconds a score stays valid before consumers treat it as zero. 0 uses the
# contract default (6 hours).
ORACLE_STALENESS_WINDOW=
