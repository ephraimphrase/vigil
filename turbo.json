{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {},
    "check-types": {},
    "test": {},
    "test:e2e": {},
    "start": {
      "cache": false,
      "persistent": true
    },
    "ponder#dev": {
      "cache": false,
      "persistent": true,
      "env": ["PONDER_RPC_URL_84532", "DATABASE_URL"]
    },
    "ponder#start": {
      "cache": false,
      "persistent": true,
      "env": ["PONDER_RPC_URL_84532", "DATABASE_URL"]
    }
  }
}
