{
  "name": "vigil",
  "version": "0.0.0",
  "private": true,
  "description": "Autonomous protocol risk monitoring and consequence execution system.",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "chain": "pnpm --filter contracts chain",
    "compile": "pnpm --filter contracts build",
    "deploy": "pnpm --filter contracts deploy",
    "prepare": "husky"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.2.5",
    "turbo": "^2.9.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": "prettier --write",
    "*.md": "prettier --write",
    "apps/contracts/**/*.sol": "sh -c 'cd apps/contracts && forge fmt'"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": "22.13.0"
  }
}
